{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npx mocha:*)",
      "Bash(npm run lint:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npm run coverage:*)",
      "Bash(npm run docs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-lint-changed.sh\"",
            "statusMessage": "format + lint changed JS"
          }
        ]
      }
    ]
  }
}
